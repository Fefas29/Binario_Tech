const express = require ('express');
const cors = require ('cors');
const loggerMiddleware = require ('./middlewares/logger');
const authMiddleware = require('./middlewares/auth');
const motoristasRouter = require ('./routes/motoristas');

const app = express ();
const PORT = 3000;

//Middleware Globais 

app.use (cors());
app.use (express.json ());
app.use (loggerMiddleware);

// Rota Publica

app.get ('/api/v1/health', (req, res) => {
	res.status(200).json ({ status: "ONLINE", aplicacao: "Binario Tech API v2"
	});
	});

//Rotas protegiadas por autenticacao

app.use('/api/v1/motoristas', authMiddleware, motoristasRouter);

app.use((req, res) => {
	res.status(404).json ({ erro: "End point nao encontrado no servidor Binario Tech" });
});

app.listen (PORT, () => {
	console.log (`[Binario Tech] Servidor de MiddleWares ativo na porta ${PORT}`);
});

